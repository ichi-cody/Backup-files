/* =============================================================================
 * wallpaper.rasi — Universal Neutral Glass Theme
 * ============================================================================= */

@import "colors.rasi"

* {
    font: "Inter Medium 11";

    background-color: transparent;

    text-color: #ffffff;
}

/* ── Window ────────────────────────────────── */

window {
    width: 820px;
    height: 700px;

    location: center;
    anchor: center;

    border: 2px;
    border-color: #3c3836;

    border-radius: 20px;

    padding: 18px;

    background-color: #0d0d0d;
}

/* ── Main Layout ───────────────────────────── */

mainbox {
    spacing: 16px;

    children: [ inputbar, listview ];
}

/* ── Search Bar ────────────────────────────── */

inputbar {
    padding: 12px 18px;

    spacing: 12px;

    border-radius: 14px;

    background-color: #181818;

    children: [ prompt, entry ];
}

entry {
    text-color: #ffffff;
    placeholder-color: #7d7d7d;
}

prompt {
    content: "";
    text-color: #ffffff;
}

/* ── Wallpaper Grid ────────────────────────── */

listview {
    columns: 3;
    lines: 2;

    spacing: 18px;

    cycle: true;

    dynamic: true;

    scrollbar: false;

    layout: vertical;
}

/* ── Wallpaper Cards ───────────────────────── */

element {
    orientation: vertical;

    padding: 10px;

    spacing: 10px;

    border-radius: 18px;
}

/* ── Selected Wallpaper ────────────────────── */

element selected.normal {
    background-color: #202020;

    border: 2px;
    border-color: #ffffff;

    border-radius: 16px;
}

/* ── Preview Image ─────────────────────────── */

element-icon {
    size: 210px;

    border-radius: 14px;

    horizontal-align: 0.5;

    vertical-align: 0.5;
}

/* ── Wallpaper Name ────────────────────────── */

element-text {
    horizontal-align: 0.5;

    text-color: @fg-main;
}
